{
  "name": "twilight-bots",
  "version": "1.0.0",
  "description": "CLI-first trading bot platform for Twilight Protocol and Binance",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "twilight-bots": "dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file=.env --import tsx/esm src/server.ts",
    "setup": "tsx src/cli/bin.ts setup",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ax-llm/ax": "^19.0.43",
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^11.7.0",
    "ccxt": "^4.4.0",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "inquirer": "^12.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
